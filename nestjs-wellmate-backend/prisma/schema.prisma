generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId          String         @id @default(uuid()) @map("user_id") @db.Uuid
  email           String         @unique @map("email") @db.VarChar(100)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  phone           String?        @unique @map("phone") @db.VarChar(20)
  role            UserRole       @map("role")
  is2faEnabled    Boolean        @default(false) @map("is_2fa_enabled")
  twoFaSecret     String?        @map("two_fa_secret") @db.VarChar(100)
  createdAt       DateTime       @default(now()) @map("created_at")
  deletedAt       DateTime?      @map("deleted_at")
  profileImageUrl String?        @map("profile_image_url") @db.VarChar(500)
  cartItems       CartItem[]
  chatMessages    ChatMessage[]
  deviceTokens    DeviceToken[]
  foodPartner     FoodPartner?
  notifications   Notification[]
  nutritionist    Nutritionist?
  patient         Patient?
  refreshTokens   RefreshToken[]
  userDiseases    UserDisease[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Patient {
  patientId          String             @id @default(uuid()) @map("patient_id") @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date
  gender             GenderType?        @map("gender")
  bloodType          String?            @map("blood_type") @db.VarChar(5)
  chronicDiseases    String[]           @map("chronic_diseases")
  isProfileComplete  Boolean            @default(false) @map("is_profile_complete")
  deletedAt          DateTime?          @map("deleted_at")
  first_name         String             @db.VarChar(100)
  last_name          String             @db.VarChar(100)
  appointments       Appointment[]
  dietaryPlans       DietaryPlan[]
  healthMetrics      HealthMetric[]
  mealPlans          MealPlan[]
  orders             Order[]
  patientAllergies   PatientAllergy[]
  user               User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  physicalActivities PhysicalActivity[]
  reviews            Review[]

  @@map("patients")
}

model Nutritionist {
  nutritionistId          String                  @id @default(uuid()) @map("nutritionist_id") @db.Uuid
  userId                  String                  @unique @map("user_id") @db.Uuid
  licenseNumber           String?                 @unique @map("license_number") @db.VarChar(50)
  licenseDocumentUrl      String?                 @map("license_document_url") @db.VarChar(500)
  consultationFee         Decimal                 @default(500.00) @map("consultation_fee") @db.Decimal(10, 2)
  verificationStatus      VerificationStatus      @default(pending) @map("verification_status")
  verifiedAt              DateTime?               @map("verified_at")
  verifiedBy              String?                 @map("verified_by") @db.Uuid
  createdAt               DateTime                @default(now()) @map("created_at")
  deletedAt               DateTime?               @map("deleted_at")
  first_name              String                  @db.VarChar(100)
  last_name               String                  @db.VarChar(100)
  appointments            Appointment[]
  mealPlans               MealPlan[]
  nutritionistLeaves      NutritionistLeave[]
  nutritionistSchedules   NutritionistSchedule[]
  nutritionistSpecialties NutritionistSpecialty[]
  user                    User                    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reviews                 Review[]

  @@map("nutritionists")
}

model PatientAllergy {
  id             Int             @id @default(autoincrement()) @map("patient_allergy_id")
  patientId      String          @map("patient_id") @db.Uuid
  ingredientName String          @map("ingredient_name") @db.VarChar(100)
  ingredientId   Int?            @map("ingredient_id")
  severity       AllergySeverity @default(moderate) @map("severity")
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  ingredient     Ingredient?     @relation(fields: [ingredientId], references: [ingredientId])
  patient        Patient         @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@index([patientId])
  @@index([ingredientId])
  @@map("patient_allergies")
}

model HealthMetric {
  id             Int           @id @default(autoincrement()) @map("health_metric_id")
  patientId      String        @map("patient_id") @db.Uuid
  weightKg       Decimal?      @map("weight_kg") @db.Decimal(5, 2)
  heightCm       Decimal?      @map("height_cm") @db.Decimal(5, 2)
  recordedAt     DateTime      @default(now()) @map("recorded_at")
  activity_level ActivityLevel @default(sedentary)
  age_years      Int?
  gender         GenderType?
  goal           String?       @db.VarChar(100)
  goal_detail    String?
  patient        Patient       @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("health_metrics")
}

model RefreshToken {
  id         String    @id @default(uuid()) @map("refresh_token_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  secretHash String    @unique @map("token_hash") @db.VarChar(255)
  deviceId   String?   @map("device_id") @db.VarChar(255)
  usedAt     DateTime? @map("used_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  family     String?   @map("family") @db.Uuid
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([secretHash])
  @@index([family])
  @@map("refresh_tokens")
}

model Specialty {
  id            Int                     @id @default(autoincrement()) @map("specialty_id")
  name          String                  @db.VarChar(100)
  description   String?
  nutritionists NutritionistSpecialty[]

  @@map("specialties")
}

model NutritionistSpecialty {
  nutritionistId String       @map("nutritionist_id") @db.Uuid
  specialtyId    Int          @map("specialty_id")
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [nutritionistId], onDelete: Cascade)
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([nutritionistId, specialtyId])
  @@map("nutritionist_specialties")
}

model NutritionistSchedule {
  nutritionistScheduleId Int          @id @default(autoincrement()) @map("nutritionist_schedule_id")
  nutritionistId         String       @map("nutritionist_id") @db.Uuid
  dayOfWeek              Int          @map("day_of_week")
  startTime              String       @map("start_time")
  endTime                String       @map("end_time")
  isAvailable            Boolean      @default(true) @map("is_available")
  nutritionist           Nutritionist @relation(fields: [nutritionistId], references: [nutritionistId], onDelete: Cascade)

  @@unique([nutritionistId, dayOfWeek])
  @@map("nutritionist_schedules")
}

model NutritionistLeave {
  nutritionistLeaveId Int          @id @default(autoincrement()) @map("nutritionist_leave_id")
  nutritionistId      String       @map("nutritionist_id") @db.Uuid
  leaveDate           DateTime     @map("leave_date") @db.Date
  isFullDay           Boolean      @default(true) @map("is_full_day")
  newStartTime        String?      @map("new_start_time")
  newEndTime          String?      @map("new_end_time")
  nutritionist        Nutritionist @relation(fields: [nutritionistId], references: [nutritionistId], onDelete: Cascade)

  @@unique([nutritionistId, leaveDate])
  @@map("nutritionist_leaves")
}

model Review {
  reviewId       Int          @id @default(autoincrement()) @map("review_id")
  appointmentId  String       @unique @map("appointment_id") @db.Uuid
  patientId      String       @map("patient_id") @db.Uuid
  nutritionistId String       @map("nutritionist_id") @db.Uuid
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [nutritionistId], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@map("reviews")
}

model Appointment {
  appointmentId  String            @id @default(uuid()) @map("appointment_id") @db.Uuid
  patientId      String            @map("patient_id") @db.Uuid
  nutritionistId String            @map("nutritionist_id") @db.Uuid
  startTime      DateTime          @map("start_time")
  endTime        DateTime          @map("end_time")
  status         AppointmentStatus @default(pending)
  type           AppointmentType   @default(online)
  chargeId       String?           @unique @map("charge_id") @db.VarChar(100)
  amount         Decimal?          @map("amount") @db.Decimal(10, 2)
  qrCodeUrl      String?           @map("qr_code_url") @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at")
  deletedAt      DateTime?         @map("deleted_at")
  nutritionist   Nutritionist      @relation(fields: [nutritionistId], references: [nutritionistId])
  patient        Patient           @relation(fields: [patientId], references: [patientId])
  chatRoom       ChatRoom?

  @@index([startTime])
  @@index([patientId])
  @@index([nutritionistId])
  @@map("appointment")
}

model FoodPartner {
  foodPartnerId      Int                 @id @default(autoincrement()) @map("food_partner_id")
  userId             String              @unique @map("user_id") @db.Uuid
  partnerName        String              @map("name") @db.VarChar(100)
  description        String?
  address            String?
  commissionRate     Decimal             @default(15.00) @map("commission_rate") @db.Decimal(4, 2)
  isActive           Boolean             @default(true) @map("is_active")
  joinedAt           DateTime            @default(now()) @map("joined_at")
  categories         String[]
  cover_image_url    String?             @db.VarChar(500)
  logo_url           String?             @db.VarChar(500)
  courses            Course[]
  user               User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  ingredientRequests IngredientRequest[]
  menuItems          MenuItem[]
  orderItems         OrderItem[]
  partnerOrders      PartnerOrder[]

  @@map("food_partners")
}

model MenuItem {
  menuItemId      Int              @id @default(autoincrement()) @map("menu_item_id")
  foodPartnerId   Int              @map("food_partner_id")
  name            String           @db.VarChar(100)
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  imageUrl        String?          @map("image_url") @db.VarChar(255)
  category        String?          @db.VarChar(50)
  caloriesKcal    Int?             @map("calories_kcal")
  proteinG        Decimal?         @map("protein_g") @db.Decimal(5, 2)
  carbsG          Decimal?         @map("carbs_g") @db.Decimal(5, 2)
  fatG            Decimal?         @map("fat_g") @db.Decimal(5, 2)
  stockQuantity   Int              @default(100) @map("stock_quantity")
  isOutOfStock    Boolean          @default(false) @map("is_out_of_stock")
  isAvailable     Boolean          @default(true) @map("is_available")
  cartItems       CartItem[]
  courseItems     CourseItem[]
  mealPlanItems   MealPlanItem[]
  menuIngredients MenuIngredient[]
  foodPartner     FoodPartner      @relation(fields: [foodPartnerId], references: [foodPartnerId], onDelete: Cascade)
  orderItems      OrderItem[]

  @@map("menu_items")
}

model Order {
  orderId           String         @id @default(uuid()) @map("order_id") @db.Uuid
  patientId         String         @map("patient_id") @db.Uuid
  dietaryPlanId     String?        @map("dietary_plan_id") @db.Uuid
  deliveryAddress   String         @map("delivery_address")
  deliveryLatitude  Decimal?       @map("delivery_latitude") @db.Decimal(10, 8)
  deliveryLongitude Decimal?       @map("delivery_longitude") @db.Decimal(11, 8)
  deliveryFee       Decimal?       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  subtotal          Decimal        @db.Decimal(10, 2)
  total             Decimal        @db.Decimal(10, 2)
  status            OrderStatus    @default(pending)
  paymentStatus     PaymentStatus  @default(UNPAID)
  chargeId          String?        @unique @map("charge_id") @db.VarChar(100)
  createdAt         DateTime       @default(now()) @map("created_at")
  contact_phone     String?        @db.VarChar(20)
  qr_code_url       String?        @db.VarChar(500)
  orderItems        OrderItem[]
  dietaryPlan       DietaryPlan?   @relation(fields: [dietaryPlanId], references: [dietaryPlanId])
  patient           Patient        @relation(fields: [patientId], references: [patientId])
  partnerOrders     PartnerOrder[]

  @@index([patientId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  orderItemId    Int         @id @default(autoincrement()) @map("order_item_id")
  orderId        String      @map("order_id") @db.Uuid
  menuItemId     Int         @map("menu_item_id")
  foodPartnerId  Int         @map("partner_id")
  quantity       Int         @default(1)
  unitPrice      Decimal     @map("unit_price") @db.Decimal(10, 2)
  note           String?     @db.VarChar(255)
  price_at_order Decimal?    @db.Decimal(10, 2)
  total_price    Decimal?    @db.Decimal(10, 2)
  menuItem       MenuItem    @relation(fields: [menuItemId], references: [menuItemId])
  order          Order       @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  foodPartner    FoodPartner @relation(fields: [foodPartnerId], references: [foodPartnerId])

  @@map("order_items")
}

model PartnerOrder {
  partnerOrderId Int         @id @default(autoincrement()) @map("partner_order_id")
  orderId        String      @map("order_id") @db.Uuid
  foodPartnerId  Int         @map("partner_id")
  status         OrderStatus @default(pending)
  accepted_at    DateTime?
  ready_at       DateTime?
  order          Order       @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  foodPartner    FoodPartner @relation(fields: [foodPartnerId], references: [foodPartnerId])

  @@map("partner_orders")
}

model DietaryPlan {
  dietaryPlanId String  @id @default(uuid()) @map("dietary_plan_id") @db.Uuid
  patientId     String  @map("patient_id") @db.Uuid
  patient       Patient @relation(fields: [patientId], references: [patientId])
  orders        Order[]

  @@map("dietary_plans")
}

model Course {
  courseId      Int            @id @default(autoincrement()) @map("course_id")
  foodPartnerId Int            @map("partner_id")
  name          String         @db.VarChar(100)
  description   String?
  coursePrice   Decimal?       @map("course_price") @db.Decimal(10, 2)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  courseItems   CourseItem[]
  foodPartner   FoodPartner    @relation(fields: [foodPartnerId], references: [foodPartnerId], onDelete: Cascade)
  mealPlanItems MealPlanItem[]

  @@map("courses")
}

model CourseItem {
  courseItemId Int      @id @default(autoincrement()) @map("course_item_id")
  courseId     Int      @map("course_id")
  menuItemId   Int      @map("menu_item_id")
  quantity     Decimal? @default(1) @db.Decimal(5, 2)
  sequence     Int?
  course       Course   @relation(fields: [courseId], references: [courseId], onDelete: Cascade)
  menuItem     MenuItem @relation(fields: [menuItemId], references: [menuItemId])

  @@map("course_items")
}

model MealPlan {
  mealPlanId     Int            @id @default(autoincrement()) @map("meal_plan_id")
  patientId      String         @map("user_id") @db.Uuid
  nutritionistId String?        @map("nutritionist_id") @db.Uuid
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  note           String?
  mealPlanItems  MealPlanItem[]
  nutritionist   Nutritionist?  @relation(fields: [nutritionistId], references: [nutritionistId])
  patient        Patient        @relation(fields: [patientId], references: [patientId])

  @@map("meal_plans")
}

model MealPlanItem {
  mealPlanItemId Int       @id @default(autoincrement()) @map("meal_plan_item_id")
  mealPlanId     Int       @map("meal_plan_id")
  planDate       DateTime  @map("plan_date") @db.Date
  is_done        Boolean   @default(false)
  logged_at      DateTime?
  menuItemId     Int?      @map("menu_item_id")
  courseId       Int?      @map("course_id")
  meal_type      String?   @db.VarChar(20)
  course         Course?   @relation(fields: [courseId], references: [courseId])
  mealPlan       MealPlan  @relation(fields: [mealPlanId], references: [mealPlanId])
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [menuItemId])

  @@map("meal_plan_items")
}

model Ingredient {
  ingredientId       Int                  @id @default(autoincrement()) @map("ingredient_id")
  code               String               @unique @db.VarChar(50)
  name               String               @db.VarChar(100)
  category           String?              @db.VarChar(50)
  createdAt          DateTime             @default(now()) @map("created_at")
  description        String?
  is_common_allergen Boolean              @default(false)
  ingredient_aliases ingredient_aliases[]
  menuIngredients    MenuIngredient[]
  patientAllergies   PatientAllergy[]

  @@index([category])
  @@index([code])
  @@index([is_common_allergen])
  @@map("ingredients")
}

model IngredientRequest {
  ingredientRequestId Int                @id @default(autoincrement()) @map("ingredient_request_id")
  foodPartnerId       Int                @map("requested_by")
  name                String             @db.VarChar(100)
  status              VerificationStatus @default(pending)
  createdAt           DateTime           @default(now()) @map("created_at")
  description         String?
  foodPartner         FoodPartner        @relation(fields: [foodPartnerId], references: [foodPartnerId])

  @@index([foodPartnerId])
  @@index([status])
  @@map("ingredient_requests")
}

model MenuIngredient {
  menuItemId   Int        @map("menu_item_id")
  ingredientId Int        @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [menuItemId], onDelete: Cascade)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
  @@index([menuItemId])
  @@map("menu_ingredients")
}

model Disease {
  diseaseId    Int           @id @default(autoincrement()) @map("disease_id")
  code         String        @unique @db.VarChar(50)
  name         String        @db.VarChar(100)
  description  String?
  userDiseases UserDisease[]

  @@index([code])
  @@map("diseases")
}

model UserDisease {
  userId    String  @map("user_id") @db.Uuid
  diseaseId Int     @map("disease_id")
  disease   Disease @relation(fields: [diseaseId], references: [diseaseId], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, diseaseId])
  @@index([diseaseId])
  @@index([userId])
  @@map("user_diseases")
}

model Notification {
  notificationId String           @id @default(uuid()) @map("notification_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(150)
  content        String
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")
  user           User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ChatRoom {
  chatRoomId    String        @id @default(uuid()) @map("chat_room_id") @db.Uuid
  appointmentId String        @unique @map("appointment_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  chatMessages  ChatMessage[]
  appointment   Appointment   @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)

  @@map("chat_rooms")
}

model ChatMessage {
  chatMessageId String      @id @default(uuid()) @map("chat_message_id") @db.Uuid
  chatRoomId    String      @map("chat_room_id") @db.Uuid
  senderId      String      @map("sender_id") @db.Uuid
  content       String
  messageType   MessageType @default(text) @map("message_type")
  createdAt     DateTime    @default(now()) @map("created_at")
  chatRoom      ChatRoom    @relation(fields: [chatRoomId], references: [chatRoomId], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [userId], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

model PhysicalActivity {
  activityId  String    @id @default(uuid()) @map("activity_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  title       String    @db.VarChar(100)
  startTime   DateTime  @map("start_time")
  calories    Int?      @map("calories")
  createdAt   DateTime  @default(now()) @map("created_at")
  deleted_at  DateTime?
  description String?
  endTime     DateTime?
  updated_at  DateTime
  patient     Patient   @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@index([patientId])
  @@index([startTime])
  @@map("physical_activities")
}

model DeviceToken {
  deviceTokenId String   @id @default(uuid()) @map("device_token_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  token         String   @unique @db.VarChar(255)
  platform      Platform @map("platform")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model CartItem {
  cartItemId String   @id @default(uuid()) @map("cart_item_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  menuItemId Int      @map("menu_item_id")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [menuItemId], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@map("cart_items")
}

model ingredient_aliases {
  ingredient_alias_id Int        @id @default(autoincrement())
  ingredient_id       Int
  alias               String     @db.VarChar(100)
  ingredients         Ingredient @relation(fields: [ingredient_id], references: [ingredientId], onDelete: Cascade)

  @@index([alias])
  @@index([ingredient_id])
}

enum UserRole {
  patient
  nutritionist
  food_partner
  admin
}

enum GenderType {
  male
  female
  other
}

enum AllergySeverity {
  mild
  moderate
  severe
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum AppointmentType {
  online
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum MessageType {
  text
  image
  file
  food_card
}

enum NotificationType {
  appointment_reminder
  payment_success
  system_alert
  order_update
  new_message
  order_status_update
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  delivering
  delivered
  cancelled
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum Platform {
  web
  android
  ios
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum ConsentType {
  pdpa
  medical_disclaimer
  marketing
}

enum DisputeStatus {
  open
  investigating
  resolved
  rejected
}

enum PlatformType {
  android
  ios
  web
}

enum SubscriptionPlan {
  monthly
  quarterly
  yearly
}

enum TransactionStatus {
  success
  failed
  pending
}
